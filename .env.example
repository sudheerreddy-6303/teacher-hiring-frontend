# ═══════════════════════════════════════════════════════════════════════════
# AcadHr FRONTEND — copy this file to .env for local development
# ═══════════════════════════════════════════════════════════════════════════
# React only reads REACT_APP_* variables. Restart npm start after changes.

# Local backend
REACT_APP_API_URL=http://localhost:5000/api

# ── Railway production (set in Railway dashboard → Frontend → Variables) ──
# REACT_APP_API_URL=https://teacher-hiring-backend-production.up.railway.app/api
#
# Important: use the BACKEND URL, not the frontend URL.
# Rebuild/redeploy frontend after changing this variable.
